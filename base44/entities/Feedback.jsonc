{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": [
        "Suggestion",
        "Bug Report",
        "General Feedback"
      ],
      "default": "General Feedback"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Reviewed",
        "Resolved"
      ],
      "default": "New"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}